# Set a newly generated secret. Empty keys fail closed on protected API routes.
API_KEY=
DATABASE_URL=./psych_history.db
LLM_BACKEND=vllm
LLM_VLLM_BASE_URL=http://127.0.0.1:8100/v1
LLM_VLLM_MODEL=your-served-model-name
LLM_VLLM_API_KEY=
LLM_LAZY_GPU=0
LLM_LOCAL_FILES_ONLY=1
LLM_MODEL_NAME=/path/to/local/checkpoint
SRAVAANI_MODEL_PATH=/path/to/SraVaani-1.0
STT_DEVICE=cpu
TELEGRAM_BOT_TOKEN=
CLINICIAN_TELEGRAM_ID=
